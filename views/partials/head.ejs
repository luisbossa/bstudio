<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= site.title %></title>
<meta name="description" content="<%= site.description %>">
<meta name="theme-color" content="<%= theme.mate %>">
<meta property="og:title" content="<%= site.title %>">
<meta property="og:description" content="<%= site.description %>">
<meta property="og:type" content="website">
<link rel="icon" href="<%= safeUrl(site.favicon, '/images/favicon.webp') %>">
<link rel="preload" href="/fonts/drukwide.otf" as="font" type="font/otf" crossorigin>
<link rel="preload" href="/fonts/degulartext.otf" as="font" type="font/otf" crossorigin>
<link rel="stylesheet" href="/css/style.css?v=20" />
<script>
    // Hide [data-reveal] elements before the first paint; main.js animates them in.
    // Safety net: if main.js never runs, show everything after 2.5s.
    (function (root) {
        if (root.hasAttribute("data-preview") || !("IntersectionObserver" in window) ||
            matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        root.classList.add("reveal-ready");
        setTimeout(function () {
            if (!window.__revealStarted) root.classList.remove("reveal-ready");
        }, 2500);
    })(document.documentElement);
</script>
<style><%- themeCss(theme) %></style>
