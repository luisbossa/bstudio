# Contact form (Gmail + app password)
EMAIL_USER=
EMAIL_PASS=

# Dashboard: password to log in at /dashboard (the panel is disabled if empty)
ADMIN_PASSWORD=
# Optional: secret used to sign the session cookie (any long random string)
SESSION_SECRET=

# Optional locally, required on Vercel: MongoDB Atlas connection string.
# Without it, content is saved to data/content.json and uploads to public/uploads.
MONGODB_URI=
MONGODB_DB=portfolio
